{
    "name": "draw-things-comfyui",
    "private": true,
    "version": "1.12.2",
    "description": "The official Draw Things extension for ComfyUI. Sends image-generation requests to Draw Things over gRPC. Supports Bridge Mode for DT+ cloud and local model execution.",
    "type": "module",
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@comfyorg/comfyui-frontend-types": "1.48.3",
        "@comfyorg/litegraph": "^0.17.2",
        "@playwright/test": "^1.64.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^24.19.2",
        "dotenv": "^18.0.8",
        "fs-extra": "^11.4.1",
        "sharp": "^0.35.5",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "build": "tsup",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "gencode": "uv run --extra dev node ./scripts/genCode.mjs"
    },
    "keywords": [],
    "author": "Kelly Jerrell",
    "license": "ISC"
}
